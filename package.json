{
  "name": "idsk",
  "version": "3.2.3",
  "packageManager": "pnpm@11.1.1",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@id-sk/react",
    "dev:docs": "turbo run storybook --filter=@idsk/docs",
    "build": "turbo run lint lint:style typecheck format:check && turbo run build",
    "build:prod": "cd packages/core && npm run build && cd ../docs && npm run build",
    "storybook": "turbo run storybook --filter=@idsk/docs",
    "test": "turbo run test test-ct",
    "test-ct": "turbo run test-ct --filter=@id-sk/react",
    "check": "turbo run lint lint:style typecheck format:check",
    "lint": "eslint .",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path .prettierignore --ignore-path .git/info/exclude --write .",
    "format:check": "prettier --ignore-path .prettierignore --ignore-path .git/info/exclude --check .",
    "typecheck": "tsc --noEmit",
    "changelog": "auto-changelog -p",
    "preversion": "git stash",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git add package.json && git commit -m \"v$(node -p \"require('./package.json').version\")\" && git tag \"v$(node -p \"require('./package.json').version\")\" && git stash pop"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint-react/eslint-plugin": "^5.7.7",
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-react": "1.60.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@whitespace/storybook-addon-html": "^9.0.0",
    "auto-changelog": "^2.5.1",
    "axe-core": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.14.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "turbo": "^2.9.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
